# --- MangoScan offline server (all values below are the defaults) ---

# Local MongoDB (browse it with MongoDB Compass at this same URI)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mangoscan

# HTTP server. HOST=127.0.0.1 keeps the machine controls reachable from this
# laptop only. Set HOST=0.0.0.0 to open the dashboard to other devices on the
# same offline network (anyone on that network can then operate the machine).
HOST=127.0.0.1
PORT=4000

# Captured images are written here (relative paths resolve from WebApp/)
STORAGE_DIR=storage

# ESP32 USB serial ports:
#   auto               scan USB serial adapters (CP210x / CH340 / FTDI / Espressif)
#   COM3,COM5          explicit list; add :baud to override one (COM5:115200)
#   mock               in-process fake controller + camera (no hardware)
#   none               no devices
SERIAL_PORTS=auto
SERIAL_BAUD=921600
# auto mode only: a different baud for boards behind one USB adapter, by vendor id
# (10c4 = CP210x, 1a86 = CH340/CH343). Example: 10c4:115200,1a86:921600
# SERIAL_ADAPTER_BAUDS=
# mock mode only: folder of .jpg files the fake camera cycles through
# MOCK_IMAGE_DIR=

# Python inference service (MyTasks/model5_fusion)
INFERENCE_URL=http://127.0.0.1:8765
INFERENCE_TIMEOUT_MS=5000
